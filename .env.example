# Copy this file to .env.local. Next.js does not load .env.example directly.
MONGODB_URI=mongodb://127.0.0.1:27017/shilpa-portfolio
ADMIN_PATH=replace-with-a-long-random-private-path
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudinary image uploads (create a free account at cloudinary.com and copy
# these values from the Cloudinary dashboard; keep the API secret private):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# For MongoDB Atlas, replace MONGODB_URI with your private connection string:
# MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/<database>?retryWrites=true&w=majority
